{% extends 'base.html.twig' %}

{% block title %}Welcome to Amine Shop!{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-12">

                <div class="text-center mb-5">
                    <h1 class="display-4">Our Products</h1>
                </div>

                {% if products is not empty %}
                    <div class="row g-4">
                        {% for product in products %}
                            <div class="col-12 col-md-6 col-lg-3">

                                <div class="card h-100 shadow-sm">
                                    <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                       class="text-decoration-none">
                                        {% if product.image %}
                                            <img src="{{ asset('uploads/imgs/products/' ~ product.image) }}"
                                                 class="card-img-top" alt="{{ product.name }}">
                                        {% else %}
                                            <img src="{{ asset('imgs/no-image.svg') }}" class="card-img-top"
                                                 alt="No image available">
                                        {% endif %}
                                    </a>

                                    <div class="card-body d-flex flex-column">
                                        <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                           class="text-decoration-none">
                                            <h5 class="card-title">{{ product.name }}</h5>
                                            <p class="card-text text-muted flex-grow-1">{{ product.description|slice(0, 80) }}{{ product.description|length > 80 ? '...' : '' }}</p>
                                        </a>
                                        <div class="mt-auto">
                                            <p class="card-text fs-5 fw-bold mb-2">{{ product.price|number_format(2, ',', ' ') }}
                                                €</p>

                                            {% if product.stock > 0 %}
                                                <a href="#" class="btn btn-outline-success w-100">Add to cart</a>
                                            {% else %}
                                                <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                                    Out of
                                                    stock
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-info mt-4">
                        Nous n'avons aucun produit disponible pour le moment. Veuillez revenir plus tard !
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
