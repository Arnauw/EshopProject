{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row">

            <div class="col-md-6">
                {% if product.image %}
                    <img src="{{ asset('uploads/imgs/products/' ~ product.image) }}" alt="{{ product.name }}" class="img-fluid rounded shadow-sm">
                {% else %}
                    <img src="{{ asset('imgs/no-image.svg') }}" class="img-fluid rounded shadow-sm" alt="No image available">
                {% endif %}
            </div>

            <div class="col-md-6">
                {% if product.subcategory %}
                    <span class="badge bg-info text-dark mb-2">{{ product.subcategory.current.name }}</span>
                {% endif %}

                <h1 class="display-5 fw-bold">{{ product.name }}</h1>

                <p class="fs-3 fw-bold text-success my-3">{{ product.price|number_format(2, ',', ' ') }} €</p>

                <div class="mb-3">
                    {% if product.stock > 0 %}
                        <span class="badge bg-success">In Stock</span>
                    {% else %}
                        <span class="badge bg-danger">Out of Stock</span>
                    {% endif %}
                </div>

                <p class="lead">{{ product.description }}</p>

                <div class="d-grid gap-2 mt-4">
                    {% if product.stock > 0 %}
                        <a href="#" class="btn btn-primary btn-lg">
                            <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                        </a>
                    {% else %}
                        <button class="btn btn-secondary btn-lg" disabled>Out of Stock</button>
                    {% endif %}
                </div>

                <hr class="my-4">

                <a href="{{ path('app_homepage') }}">← Back to all products</a>
            </div>

        </div>
        <h2 class="mt-5 text-center">Last products added</h2>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-12">

                    {% if lastProducts is not empty %}
                        <div class="row g-4">
                            {% for product in lastProducts %}
                                <div class="col-12 col-md-6 col-lg-3">

                                    <div class="card h-100 shadow-sm">
                                        <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                           class="text-decoration-none">
                                            {% if product.image %}
                                                <img src="{{ asset('uploads/imgs/products/' ~ product.image) }}"
                                                     class="card-img-top" alt="{{ product.name }}">
                                            {% else %}
                                                <img src="{{ asset('imgs/no-image.svg') }}" class="card-img-top"
                                                     alt="No image available">
                                            {% endif %}
                                        </a>

                                        <div class="card-body d-flex flex-column">
                                            <a href="{{ path('app_product_show', {'id': product.id}) }}"
                                               class="text-decoration-none">
                                                <h5 class="card-title">{{ product.name }}</h5>
                                                <p class="card-text text-muted flex-grow-1">{{ product.description|slice(0, 80) }}{{ product.description|length > 80 ? '...' : '' }}</p>
                                            </a>
                                            <div class="mt-auto">
                                                <p class="card-text fs-5 fw-bold mb-2">{{ product.price|number_format(2, ',', ' ') }}
                                                    €</p>

                                                {% if product.stock > 0 %}
                                                    <a href="#" class="btn btn-outline-success w-100">Add to cart</a>
                                                {% else %}
                                                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                                        Out of
                                                        stock
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info mt-4">
                            Nous n'avons aucun produit disponible pour le moment. Veuillez revenir plus tard !
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
{% endblock %}
