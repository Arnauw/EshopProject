{% extends 'base.html.twig' %}

{% block title %}Add Stock to {{ product.name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h1 class="card-title text-center h3 mb-4">Add Stock to "{{ product.name }}"</h1>

                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_row(form.stock) }}
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Add Stock</button>
                        </div>

                        {{ form_end(form) }}
                    </div>

                    <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                        <a href="{{ path('app_product_index') }}">Back to list</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
