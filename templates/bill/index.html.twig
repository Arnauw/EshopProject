<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice #{{ order.id }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            color: #333;
        }

        .container {
            width: 100%;
            margin: 0 20px;
        }

        .header, .footer {
            text-align: center;
        }

        .details-section {
            margin-top: 30px;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .totals-table {
            width: 50%;
            margin-left: auto;
            margin-top: 20px;
        }

        .totals-table td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .text-end {
            text-align: right;
        }

        .fw-bold {
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">

    <div class="header">
        <h1>Facture</h1>
        <p><strong>Invoice #:</strong> {{ order.id }}</p>
        <p><strong>Order Date:</strong> {{ order.createdAt|date('F jS, Y') }}</p>
    </div>

    <hr>

    <div class="details-section">
        <h4 style="margin-bottom: 5px;">Billed To:</h4>
        <p style="margin: 0;">{{ order.firstName }} {{ order.lastName }}</p>
        <p style="margin: 0;">{{ order.address }}, {{ order.city.name }}</p>
        <p style="margin: 0;">{{ order.phoneNumber }}</p>
    </div>

    <h4>Order Details</h4>
    <table>
        <thead>
        <tr>
            <th>Product</th>
            <th class="text-end">Quantity</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Total</th>
        </tr>
        </thead>
        <tbody>
        {% for orderProduct in order.orderProducts %}
            <tr>
                <td>{{ orderProduct.product.name }}</td>
                <td class="text-end">{{ orderProduct.quantity }}</td>
                <td class="text-end">{{ orderProduct.product.price|number_format(2, ',', ' ') }} €</td>
                <td class="text-end">{{ (orderProduct.product.price * orderProduct.quantity)|number_format(2, ',', ' ') }}
                    €
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="totals-table">
        <tbody>
        <tr>
            <td>Shipping Cost:</td>
            <td class="text-end">{{ order.city.shippingCost|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="fw-bold">Total to Pay:</td>
            <td class="text-end fw-bold">{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>
        </tr>
        </tbody>
    </table>

    <div class="footer" style="margin-top: 50px;">
        <p>Thank you for your business!</p>
    </div>

</div>
</body>
</html>
