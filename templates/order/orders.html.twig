{% extends 'base.html.twig' %}

{% block title %}Manage Orders{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-12 col-lg-10">

                <h1 class="mb-4">Orders</h1>

                {% if orders is not empty %}
                    <div class="accordion" id="ordersAccordion">
                        {% for order in orders %}
                            <div class="accordion-item shadow-sm mb-3">

                                <h2 class="accordion-header" id="heading-{{ order.id }}">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ order.id }}" aria-expanded="false" aria-controls="collapse-{{ order.id }}">
                                        <div class="w-100 d-flex justify-content-between pe-3">
                                            <span class="fw-bold">Order #{{ order.id }}</span>
                                            <span class="text-muted">{{ order.firstName }} {{ order.lastName }}</span>
                                            <span>{{ order.createdAt|date('F jS, Y') }}</span>
                                            <span>
{#                                                {% if order.isCompleted %}#}
{#                                                    <span class="badge bg-success">Delivered</span>#}
{#                                                {% else %}#}
{#                                                    <span class="badge bg-warning text-dark">Pending</span>#}
{#                                                {% endif %}#}
                                            </span>
                                        </div>
                                    </button>
                                </h2>

                                <div id="collapse-{{ order.id }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ order.id }}" data-bs-parent="#ordersAccordion">
                                    <div class="accordion-body">

                                        <h5 class="mb-3">Client Information</h5>
                                        <div class="list-group list-group-flush mb-4">
                                            <div class="list-group-item"><div class="row"><div class="col-4 fw-bold">Name:</div><div class="col-8">{{ order.firstName }} {{ order.lastName }}</div></div></div>
                                            <div class="list-group-item"><div class="row"><div class="col-4 fw-bold">Phone:</div><div class="col-8">{{ order.phoneNumber }}</div></div></div>
                                            <div class="list-group-item"><div class="row"><div class="col-4 fw-bold">Address:</div><div class="col-8">{{ order.address }}, {{ order.city.name }}</div></div></div>
                                        </div>

                                        <h5 class="mb-3">Order Details</h5>
                                        <div class="list-group list-group-flush mb-4">
                                            {% for orderProduct in order.orderProducts %}
                                                <div class="list-group-item">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-1"><img src="{{ asset('uploads/products/' ~ orderProduct.product.image) }}" class="img-fluid rounded border" alt="{{ orderProduct.product.name }}"></div>
                                                        <div class="col-md-4 fw-bold">{{ orderProduct.product.name }}</div>
                                                        <div class="col-md-2 text-muted">x {{ orderProduct.quantity }}</div>
                                                        <div class="col-md-2">{{ (orderProduct.product.price * orderProduct.quantity)|number_format(2, ',', ' ') }} €</div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                            <div class="list-group-item list-group-item-light"><div class="row"><div class="col-9 text-end text-muted">Shipping Cost:</div><div class="col-3 fw-bold">{{ order.city.shippingCost|number_format(2, ',', ' ') }} €</div></div></div>
                                            <div class="list-group-item list-group-item-light"><div class="row"><div class="col-9 text-end fw-bold">Total Price:</div><div class="col-3 fw-bold">{{ order.totalPrice|number_format(2, ',', ' ') }} €</div></div></div>
                                        </div>

                                        <div class="text-end">
                                            <a class="btn btn-outline-success btn-sm" href="{#{{ path('app_bill',{'id':order.id}) }}#}">Print Bill</a>
{#                                            {% if not order.isCompleted %}#}
{#                                                <a href="#}{#{{ path('app_orders_is-completed-update',{'id':order.id}) }}#}{#" class='btn btn-outline-primary btn-sm ms-2'>Mark as Delivered</a>#}
{#                                            {% endif %}#}
                                            <a onclick="return confirm('Are you sure you want to delete this order?')" href="{#{{ path('app_orders_remove',{'id':order.id})}}#}" class='btn btn-outline-danger btn-sm ms-2'>Delete Order</a>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="mt-4 d-flex justify-content-center">
                        {{ knp_pagination_render(orders, 'layouts/_pagination.html.twig') }}
                    </div>
                {% else %}
                    <div class="alert alert-info">No orders found.</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
