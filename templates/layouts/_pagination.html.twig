{% if pageCount > 1 %}
    <nav aria-label="..." class="mt-3">
        <ul class="pagination paginatorButton">
            {% if previous is defined %}
                <li class="page-item">
                    <a href="{{ path(route, query|merge({(pageParameterName):previous})) }}" class="page-link">Previous</a>
                </li>
            {% endif %}

            {% for page in pagesInRange %}
                {% if page != current %}
                    <li class="page-item active" aria-current="page">
                        <a class="page-link" href="{{ path(route, query|merge({(pageParameterName):page})) }}">{{ page }} </a>
                    </li>
                {% else %}
                    <li class="page-item active" aria-current="page">
                        <a style="background: green" class="page-link disabled" href="{{ path(route, query|merge({(pageParameterName):page})) }}">{{ page }} </a>
                    </li>
                {% endif %}
            {% endfor %}

            {% if next is defined %}
                <li class="page-item">
                    <a href="{{ path(route, query|merge({(pageParameterName):next})) }}" class="page-link">Next</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
