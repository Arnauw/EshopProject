<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand" href="{{ path('app_homepage') }}">Amine Shop</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    {#                    {{ dump(app.request.pathInfo) }} #}
                    {#                    {{ dump(app.admin_user.roles) }} #}

                    {% if is_granted('ROLE_ADMIN') and 'admin' not in app.request.pathInfo %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin') }}">Dashboard</a>
                        </li>
                    {% endif %}

                    {% if categories is defined and categories is not empty %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" role="button" aria-expanded="false" href="">
                                Categories
                            </a>
                            <ul class="dropdown-menu">

                                {% for category in categories %}
                                    <li><a class="dropdown-item fw-bold" href="">{{ category.name }}</a></li>
                                    {% for subcategory in category.subcategories %}
                                        <li><a class="dropdown-item"
                                               href="{{ path('app_home_product_filter', {'id': subcategory.id}) }}">{{ subcategory.name }}</a>
                                        </li>
                                    {% endfor %}
                                    {% if not loop.last %}
                                        <li class="dropdown-divider"></li>
                                    {% endif %}
                                {% endfor %}

                            </ul>
                        </li>
                    {% endif %}

                    {% if 'admin' in app.request.pathInfo %}

                        {% if 'product' not in app.request.pathInfo %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" role="button" aria-expanded="false"
                                   href="{{ path('app_product_index') }}">
                                    Products
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_product_new') }}">Create new
                                            product</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if 'subcategory' not in app.request.pathInfo %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="{{ path('app_subCategory_index') }}"
                                   role="button"
                                   aria-expanded="false">
                                    Subcategories
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_subCategory_new') }}">Create new
                                            subcategory</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if 'categories' not in app.request.pathInfo %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="{{ path('app_category_show') }}" role="button"
                                   aria-expanded="false">
                                    Categories
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_category_new') }}">Create new
                                            category</a></li>
                                </ul>
                            </li>
                        {% endif %}

                        {% if 'city' not in app.request.pathInfo %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" role="button" aria-expanded="false"
                                   href="{{ path('app_city_index') }}">
                                    Cities
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="{{ path('app_city_new') }}">Create new city</a>
                                    </li>
                                </ul>
                            </li>

                        {% endif %}

                        {% if 'admin/users' not in app.request.pathInfo %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" role="button" aria-expanded="false"
                                   href="{{ path('app_user_show') }}">
                                    Users
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_user_new') }}">Create new user</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_user_new') }}">Create new user</a>
                                    </li>
                                </ul>
                            </li>
                        {% endif %}

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle" href="{{ path('app_order_list',{'type':'all'}) }}" role="button"  aria-expanded="false">
                                Orders
                            </a>

                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_order_list',{'type':'is-completed'}) }}">Delivered
                                        orders</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_order_list',{'type':'no_delivery'}) }}">Undelivered
                                        orders</a></li>
                                <li><a class="dropdown-item"
                                       href="{{ path('app_order_list',{'type':'pay-on-stripe-not-delivered'}) }}">Online
                                        paid orders not delivered</a></li>
                                <li><a class="dropdown-item"
                                       href="{{ path('app_order_list',{'type':'pay-on-stripe-is-delivered'}) }}">Online paid
                                        orders delivered</a></li>
                            </ul>
                        </li>

                    {% endif %}

                </ul>

                <div class="navbar-nav ms-auto">

                    <div class="nav-item mt-1">
                            <span class="navbar-text me-3">
                                Welcome, {{ app.user.firstName|default(app.user.userIdentifier) }}!
                            </span>
                    </div>

                    <form data-turbo='false' method="post" action="{{ path('app_search')}}" class="d-flex me-3" role="search">
                        <input name="word" class="form-control me-2" type="search" placeholder="Search a product" aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>

                    <div class="nav-item me-4">
                        <a href="{{ path('app_cart') }}" class="nav-link position-relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-cart" viewBox="0 0 16 16">
                                <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                            {% set cart_quantity = cart_service.getCartQuantity() %}
                            {% if cart_quantity > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        {{ cart_quantity }}
                                        <span class="visually-hidden">items in cart</span>
                                    </span>
                            {% endif %}
                        </a>
                    </div>


                    {% if app.user %}
                        <div class="nav-item">
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-light">Logout</a>
                        </div>

                    {% else %}

                        <div class="nav-item">
                            <a href="{{ path('app_login') }}" class="nav-link">Login</a>
                        </div>
                        <div class="nav-item">
                            <a href="{{ path('app_register') }}" class="btn btn-primary">Register</a>
                        </div>
                    {% endif %}
                </div>

            </div>
        </div>
    </nav>
</header>
