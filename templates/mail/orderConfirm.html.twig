<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Confirmation of order #{{ order.id }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
            line-height: 1.5;
        }

        .container {
            padding: 20px;
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #ddd;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid #eee;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #f7f7f7;
        }

        .text-right {
            text-align: right;
        }

        .totals {
            margin-top: 20px;
        }

        .totals td {
            border: none;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>Confirmation of order #{{ order.id }}</h1>
    </div>

    <p><strong>Date:</strong> {{ order.createdAt|date('F jS, Y H:i') }}</p>
    <p>Thank you for your order, {{ order.firstName }}. It will be processed as soon as possible.</p>

    <hr>

    <h4>Order Details</h4>

    <table class="client-details">
        <tr>
            <th>Name</th>
            <td>{{ order.firstName }} {{ order.lastName }}</td>
        </tr>
        <tr>
            <th>Phone Number</th>
            <td>{{ order.phoneNumber }}</td>
        </tr>
        <tr>
            <th>Address</th>
            <td>{{ order.address }}, {{ order.city.name }}</td>
        </tr>
    </table>

    <h4>Order Body</h4>
    <table class="order-body">
        <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th class="text-right">Total Price</th>
        </tr>
        </thead>
        <tbody>
        {% for orderProduct in orderProducts %}
            <tr>
                <td>{{ orderProduct.product.name }}</td>
                <td>{{ orderProduct.quantity }}</td>
                <td class="text-right">{{ (orderProduct.product.price * orderProduct.quantity)|number_format(2, ',', ' ') }}
                    €
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td>Shipping fees:</td>
            <td class="text-right">{{ order.city.shippingCost|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td><strong style="font-size: 1.2em;">Total to pay:</strong></td>
            <td class="text-right"
                style="font-size: 1.2em; font-weight: bold;">{{ order.totalPrice|number_format(2, ',', ' ') }} €
            </td>
        </tr>
    </table>
</div>
</body>
</html>
