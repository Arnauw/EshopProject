{% extends 'base.html.twig' %}

{% block title %}Edit City{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center mb-5">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="card-title text-center mb-4">Edit City</h1>
                        {{ include('city/_form.html.twig', {'button_label': 'Update'}) }}
                    </div>

                    <hr class="my-0">

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('app_city_index') }}" class="btn btn-light">Back to list</a>
                            {{ include('city/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
