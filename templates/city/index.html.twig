{% extends 'base.html.twig' %}

{% block title %}Manage Cities{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">Cities</h1>
                    <a href="{{ path('app_city_new') }}" class="btn btn-primary">
                        Create New
                    </a>
                </div>

                {% if cities is not empty %}
                    <div class="row text-muted fw-bold d-none d-md-flex mb-2 px-3 align-items-center">
                        <div class="col-md-5">Name</div>
                        <div class="col-md-4">Shipping Cost</div>
                        <div class="col-md-3 text-end">Actions</div>
                    </div>

                    <div class="list-group shadow-sm">
                        {% for city in cities %}
                            <div class="list-group-item">
                                <div class="row align-items-center">

                                    <div class="col-12 col-md-5 mb-2 mb-md-0">
                                        <span class="fw-bold">{{ city.name }}</span>
                                    </div>

                                    <div class="col-12 col-md-4 mb-2 mb-md-0">
                                        <span class="fw-bold">{{ city.shippingCost|number_format(2, ',', ' ') }} €</span>
                                    </div>

                                    <div class="col-12 col-md-3 text-md-end">
                                        <a href="{{ path('app_city_edit', {'id': city.id}) }}" class="btn btn-light btn-sm">Edit</a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-info mb-0">
                        No cities found. <a href="{{ path('app_city_new') }}" class="alert-link">Create the first one!</a>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
