{% extends 'base.html.twig' %}

{% block title %}Search Engine{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="mb-5 mt-5">Result of search for " {{ word }} "</h1>
        <div class="row">
            {% for product in products %}
                <div class="col-md-3 mt-4">
                    <div class="card" style="width: 18rem;">
                        <a class="productLink" href="{{ path('app_product_show',{'id':product.id}) }} ">
                            <img src="{{ asset('uploads/imgs/products/'~product.image) }}"
                                 class="imgproduct card-img-top" alt="Image of {{ product.name }}">
                        </a>
                        <div class="card-body">
                            <a class="productLink" href="{{ path('app_product_show',{'id':product.id}) }} ">
                                <h5 class="card-title titleProduct">{{ product.name }}</h5>
                                <p class="card-text">{{ product.description|slice(0,60) }}</p>
                            </a>
                            <h3>{{ product.price }} €</h3>
                            <a href="{{ path('app_cart_add_product',{'id':product.id}) }}"
                               class="btn btn-outline-success">Add to cart</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {{ knp_pagination_render(products, 'layouts/_pagination.html.twig') }}
    </div>
{% endblock %}


