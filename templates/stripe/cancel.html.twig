{% extends 'base.html.twig' %}

{% block title %}Payment Canceled{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm text-center border-warning">
                    <div class="card-body p-5">

                        <div class="display-3 mb-3">⚠️</div>

                        <h1 class="card-title h2">Payment Canceled</h1>
                        <p class="card-text lead">Your payment process was canceled. You have not been charged.</p>
                        <hr class="my-4">
                        <p class="text-muted">Your items are still waiting for you in your cart.</p>

                        <a href="{{ path('app_cart') }}" class="btn btn-primary mt-3">
                            Return to Cart
                        </a>
                        <a href="{{ path('app_homepage') }}" class="btn btn-link mt-3">
                            Continue Shopping
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
