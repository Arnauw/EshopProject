{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm text-center border-success">
                    <div class="card-body p-5">

                        <div class="display-3 mb-3">✅</div>

                        <h1 class="card-title h2">Thank You!</h1>
                        <p class="card-text lead">Your payment was successful and your order has been placed.</p>
                        <hr class="my-4">
                        <p class="text-muted">A confirmation email has been sent to you. We will begin processing your order shortly.</p>

                        <a href="{{ path('app_homepage') }}" class="btn btn-primary mt-3">
                            Continue Shopping
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
